{
  "name": "@hubnet-systems/component-library",
  "version": "0.1.11",
  "private": true,
  "description": "Cross-platform UI primitives for web and React Native",
  "type": "module",
  "sideEffects": [
    "./dist/web/style.css"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./icons": {
      "types": "./dist/types/icons/index.d.ts",
      "react-native": "./dist/native/icons/index.mjs",
      "import": "./dist/web/icons/index.mjs",
      "require": "./dist/web/icons/index.cjs",
      "default": "./dist/web/icons/index.mjs"
    },
    "./icons/*": {
      "types": "./dist/types/icons/*.d.ts",
      "react-native": "./dist/native/icons/*.mjs",
      "import": "./dist/web/icons/*.mjs",
      "require": "./dist/web/icons/*.cjs",
      "default": "./dist/web/icons/*.mjs"
    },
    "./themes/lulafi": {
      "types": "./dist/types/themes/lulafi.d.ts",
      "react-native": "./dist/native/themes/lulafi.mjs",
      "import": "./dist/web/themes/lulafi.mjs",
      "require": "./dist/web/themes/lulafi.cjs",
      "default": "./dist/web/themes/lulafi.mjs"
    },
    "./dashboard": {
      "types": "./dist/types/dashboard/index.d.ts",
      "import": "./dist/web/dashboard/index.mjs",
      "require": "./dist/web/dashboard/index.cjs",
      "default": "./dist/web/dashboard/index.mjs"
    },
    "./dashboard.css": {
      "types": "./dist/types/dashboard/css.d.ts",
      "default": "./dist/web/style.css"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "icons": [
        "dist/types/icons/index.d.ts"
      ],
      "icons/*": [
        "dist/types/icons/*"
      ],
      "themes/lulafi": [
        "dist/types/themes/lulafi.d.ts"
      ],
      "dashboard": [
        "dist/types/dashboard/index.d.ts"
      ],
      "dashboard.css": [
        "dist/types/dashboard/css.d.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "compile": "npm run test && npm run clean && npm run build:js && npm run build:types && npm run validate:package",
    "build:js": "tsdown",
    "build:types": "tsc -p tsconfig.build.json",
    "generate:icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx src tsdown.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run generate:icons && npm run lint && npm run typecheck",
    "validate:package": "node scripts/validate-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hubnet-systems/component-library.git"
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tsdown/css": "0.23.1",
    "@types/react": "^19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^8.57.1",
    "phosphor-react-native": "3.0.6",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-native": "^0.83.6",
    "react-native-svg": "^15.15.3",
    "rimraf": "^6.0.1",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.2"
  }
}
